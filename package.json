{
  "name": "smart-worksheet-generator-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Smart Worksheet Generator - AI-powered reading comprehension worksheet builder",
  "author": "Smart Worksheet Generator Team",
  "type": "module",
  "scripts": {
